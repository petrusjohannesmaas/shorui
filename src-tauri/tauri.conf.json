{
  "productName": "Shorui",
  "version": "0.1.0",
  "identifier": "com.shorui.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Shorui",
        "width": 1200,
        "height": 750,
        "resizable": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"],
        "desktopTemplate": "Shorui.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "txt"],
        "mimeType": "text/markdown"
      }
    ]
  },
  "plugins": {}
}
