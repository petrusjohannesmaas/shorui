{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Shorui",
  "version": "0.2.0",
  "identifier": "com.petrusjohannesmaas.shorui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shorui",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"],
        "desktopTemplate": "Shorui.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "txt"],
        "mimeType": "text/markdown"
      }
    ]
  },
  "plugins": {}
}
